# ============================================================
# PanelAI - Environment Configuration Template
# ============================================================

# Google Gemini API Key (Optional: enables real-time LLM moderator decisions & resume parsing)
# If omitted, PanelAI automatically falls back to its deterministic offline rule engine.
GEMINI_API_KEY=""

# Agora RTC Credentials (Optional: enables WebRTC voice streaming)
# If omitted, PanelAI automatically uses browser Web Speech APIs & Web Audio analyser.
NEXT_PUBLIC_AGORA_APP_ID=""
NEXT_AGORA_APP_CERTIFICATE=""
AGORA_CUSTOMER_ID=""
AGORA_CUSTOMER_SECRET=""

# Conversational Agent Configuration
NEXT_PUBLIC_AGENT_UID="333"
NEXT_PUBLIC_DEBUG_MODE="false"
NEXT_PUBLIC_DEMO_MODE="false"

# Development & Server Settings
PORT=3000
NODE_ENV="development"
